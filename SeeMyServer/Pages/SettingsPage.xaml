<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SeeMyServer.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SeeMyServer.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="TransparentStyle" TargetType="Grid">
            <!--  设置背景  -->
            <Setter Property="Background" Value="#11FFFFFF" />
            <!--  设置边框  -->
            <Setter Property="BorderBrush" Value="#11FFFFFF" />
            <!--  设置边框厚度  -->
            <Setter Property="BorderThickness" Value="0" />
            <!--  设置圆角  -->
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="SettingsHeader"
            x:Uid="SettingsHeader"
            Grid.Row="0"
            Grid.Column="0"
            Margin="24,24,0,8"
            HorizontalAlignment="Left"
            FontSize="24" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="AppearanceSetting"
                x:Uid="AppearanceSetting"
                Grid.Row="0"
                Margin="24,18,0,8" />
            <Grid
                Grid.Row="1"
                Margin="24,0,24,0"
                Padding="28,16,28,16"
                Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}"
                BorderThickness="0"
                CornerRadius="4,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    Glyph="&#xE790;" />
                <TextBlock
                    x:Name="ThemeSetting"
                    x:Uid="ThemeSetting"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center" />
                <ComboBox
                    x:Name="backgroundMaterial"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind material}"
                    SelectionChanged="backgroundMaterial_SelectionChanged" />
            </Grid>
            <Grid
                Grid.Row="2"
                Margin="24,1,24,0"
                Padding="28,16,28,16"
                Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}"
                BorderThickness="0"
                CornerRadius="0,0,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    Glyph="&#xF2B7;" />
                <TextBlock
                    x:Name="LanguageSetting"
                    x:Uid="LanguageSetting"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center" />
                <ComboBox
                    x:Name="languageChange"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind language}"
                    SelectionChanged="languageChange_SelectionChanged" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="SSHBehavior"
                x:Uid="SSHBehavior"
                Grid.Row="0"
                Margin="24,18,0,8" />
            <Grid
                Grid.Row="1"
                Margin="24,0,24,0"
                Padding="28,16,28,16"
                Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}"
                BorderThickness="0"
                CornerRadius="4,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    Glyph="&#xF8AE;" />
                <TextBlock
                    x:Name="LosesFocusStopSSH"
                    x:Uid="LosesFocusStopSSH"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center" />
                <ComboBox
                    x:Name="LosesFocusStopSSHComboBox"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind losesFocus}"
                    SelectionChanged="LosesFocusStopSSHComboBox_SelectionChanged" />
            </Grid>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="SSHKeySetting"
                x:Uid="SSHKeySetting"
                Grid.Row="0"
                Margin="24,18,0,8" />
            <Grid
                Grid.Row="1"
                Margin="24,0,24,0"
                Padding="28,16,28,16"
                Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}"
                BorderThickness="0"
                CornerRadius="4,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    Glyph="&#xE72E;" />
                <TextBlock
                    x:Uid="ManageSSHKeysSetting"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center" />
                <Button
                    x:Uid="ManageSSHKeysButton"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="ManageSSHKeysButton_Click" />
            </Grid>
            <Grid
                Grid.Row="2"
                Margin="24,1,24,0"
                Padding="28,16,28,16"
                Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}"
                BorderThickness="0"
                CornerRadius="0,0,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    Glyph="&#xE8D4;" />
                <TextBlock
                    x:Uid="WindowsHelloSetting"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center" />
                <ToggleSwitch
                    x:Name="WindowsHelloToggle"
                    Grid.Column="2"
                    Margin="0,0,-113,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    OffContent=""
                    OnContent=""
                    Toggled="WindowsHelloToggle_Toggled" />
            </Grid>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="LogSetting"
                x:Uid="LogSetting"
                Grid.Row="0"
                Margin="24,18,0,8" />
            <Grid
                Grid.Row="1"
                Margin="24,1,24,24"
                Padding="28,16,28,16"
                Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}"
                BorderThickness="0"
                CornerRadius="0,0,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE81E;" />
                    <TextBlock
                        x:Uid="OpenLogFolderSetting"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
                    <Button
                        x:Uid="OpenLogFolderButton"
                        Click="OpenLogFolderButton_Click" />
                    <Button
                        x:Uid="ClearLogButton"
                        Click="ClearLogButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
