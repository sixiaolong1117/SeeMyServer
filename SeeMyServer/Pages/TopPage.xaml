<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SeeMyServer.Pages.TopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:SeeMyServer.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid Padding="24,24,0,0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,0,8"
                FontSize="24"
                Text="{Binding Name}" />
            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Margin="8,0,0,8"
                VerticalAlignment="Bottom"
                Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                Text="{Binding HostIP}" />
            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                Margin="8,0,24,0"
                Padding="0,4,0,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="12"
                Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                Text="{Binding NumberOfFailuresStr}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Padding="0,4"
                HorizontalContentAlignment="Left"
                Click="SortByPID_Click"
                Background="Transparent"
                BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,4,0"
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                        Text="PID" />
                    <TextBlock
                        x:Name="SortPIDIcon"
                        FontSize="10"
                        Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="1"
                Padding="0,4"
                HorizontalContentAlignment="Left"
                Click="SortByCommand_Click"
                Background="Transparent"
                BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,4,0"
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                        Text="Command" />
                    <TextBlock
                        x:Name="SortCommandIcon"
                        FontSize="10"
                        Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                Padding="0,4"
                HorizontalContentAlignment="Right"
                Click="SortByCPU_Click"
                Background="Transparent"
                BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,4,0"
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                        Text="CPU%" />
                    <TextBlock
                        x:Name="SortCPUIcon"
                        FontSize="10"
                        Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="3"
                Padding="0,4"
                HorizontalContentAlignment="Right"
                Click="SortByMEM_Click"
                Background="Transparent"
                BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,4,0"
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                        Text="MEM%" />
                    <TextBlock
                        x:Name="SortMEMIcon"
                        FontSize="10"
                        Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="4"
                Padding="0,4"
                HorizontalContentAlignment="Right"
                Click="SortByTime_Click"
                Background="Transparent"
                BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,4,0"
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                        Text="Time" />
                    <TextBlock
                        x:Name="SortTimeIcon"
                        FontSize="10"
                        Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="5"
                Padding="0,4"
                HorizontalContentAlignment="Center"
                Click="SortByStatus_Click"
                Background="Transparent"
                BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,4,0"
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                        Text="Status" />
                    <TextBlock
                        x:Name="SortStatusIcon"
                        FontSize="10"
                        Foreground="{ThemeResource SystemControlBackgroundBaseMediumBrush}" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView
            Grid.Row="2"
            x:Name="ProcessListView"
            Margin="0,4,24,0"
            ItemsSource="{Binding TopProcesses}"
            SelectionMode="None"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ScrollViewer.IsHorizontalRailEnabled="False"
            ItemContainerTransitions="{x:Null}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:TopProcessInfo">
                    <Grid
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,4,0,4"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{Binding PID}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="0,4,0,4"
                            VerticalAlignment="Center"
                            TextWrapping="NoWrap"
                            Text="{Binding Command}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="0,4,0,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{Binding CPUPercent}" />
                        <TextBlock
                            Grid.Column="3"
                            Margin="0,4,0,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{Binding MEMPercent}" />
                        <TextBlock
                            Grid.Column="4"
                            Margin="0,4,0,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{Binding Time}" />
                        <Border
                            Grid.Column="5"
                            Height="22"
                            Padding="6,0,6,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                            CornerRadius="3,3,3,3">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource SystemControlForegroundAltHighBrush}"
                                Text="{Binding Status}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <CommandBar
            Grid.Row="3"
            Grid.Column="0"
            Margin="0,0,0,4"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsOpen="False">
            <AppBarButton
                x:Uid="HomePageReloadPage"
                Click="Refresh_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE895;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Grid>
</Page>
